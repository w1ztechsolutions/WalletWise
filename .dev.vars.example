# WalletWise — local development secrets
#
# Copy this file to `.dev.vars` (gitignored) for `wrangler pages dev`.
# Never commit real credentials.
#
# ---------------------------------------------------------------------------
# Auth (required for a working local sign-in)
# ---------------------------------------------------------------------------
# Better Auth reads these from the environment (see node_modules/better-auth
# secret-utils). Without BETTER_AUTH_SECRET a local instance signs sessions
# with a development default, which is unsafe and produces cookies that do not
# survive a restart. Generate one per machine:
#
#   openssl rand -base64 32
#
# The same two values must exist in production (Settings → Environment
# variables and secrets on the Pages project, or `wrangler pages secret put`).
#
# Production equivalents:
#   npx wrangler pages secret put BETTER_AUTH_SECRET
#   npx wrangler pages secret put BETTER_AUTH_URL
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:8788

# ---------------------------------------------------------------------------
# R2 presigned URLs (Phase 6.5)
# ---------------------------------------------------------------------------
# S3-compatible credentials are required because the R2 Workers binding cannot
# generate signed URLs itself:
#   1. Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API token
#      → Object Read & Write, scoped to `walletwise-storage`
#   2. Copy the "Access Key ID" / "Secret Access Key" values below.
#   3. Your Account ID: Cloudflare Dashboard → right sidebar → Account ID.
#
# Production equivalents:
#   npx wrangler secret put R2_ACCOUNT_ID
#   npx wrangler secret put R2_ACCESS_KEY_ID
#   npx wrangler secret put R2_SECRET_ACCESS_KEY

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ---------------------------------------------------------------------------
# Error verbosity
# ---------------------------------------------------------------------------
# Runtime marker read by `functions/lib/errors.ts`.
#
# "development" is the ONLY value that returns `details` (stack traces, D1 error
# text) in HTTP error responses. Any other value — including a missing binding —
# is treated as production and stays fully sanitized.
#
# This is exactly why you want it in `.dev.vars`: `wrangler pages dev` reads this
# file and overrides the `"production"` default declared in `wrangler.jsonc`.
ENVIRONMENT=development

# Optional local override (normally provided by wrangler.jsonc `vars`):
# R2_BUCKET_NAME=walletwise-storage
